//this is for second modal that shows the results of the search.
class MovieResultsModal extends Modal {
	results: any[];
	onSelect: (movie: any) => void;

	constructor(
		app: App,
		results: any[],
		onSelect: (movie: any) => void,
	) {
		super(app);
		this.results = results;
		this.onSelect = onSelect;
	}

	onOpen() {
	const { contentEl } = this;

	contentEl.createEl('h2', { text: 'Select a movie' });

	if (this.results.length === 0) {
		contentEl.createEl('p', {
			text: 'No movies found.',
		});

		const doneButton = contentEl.createEl('button', {
			text: 'Okay',
		});

		doneButton.style.marginTop = '10px';

		doneButton.addEventListener('click', () => {
			this.close();
		});

		return;
	}

	for (const movie of this.results) {
		const year = movie.release_date
			? movie.release_date.substring(0, 4)
			: 'Unknown year';

		const item = contentEl.createEl('div');

		item.style.padding = '10px';
		item.style.cursor = 'pointer';
		item.style.borderBottom =
			'1px solid var(--background-modifier-border)';

		item.createEl('div', {
			text: movie.title,
		});

		item.createEl('small', {
			text: `${year}  •  TMDB ID: ${movie.id}`,
		});

		if (movie.overview) {
			item.createEl('p', {
				text: getPlotPreview(movie.overview),
			});
		}

		item.addEventListener('click', () => {
			this.onSelect(movie);
			this.close();
		});
	}
}

	onClose() {
		this.contentEl.empty();
	}
}

class TVShowResultsModal extends Modal {
	results: any[];
	onSelect: (show: any) => void;

	constructor(
		app: App,
		results: any[],
		onSelect: (show: any) => void,
	) {
		super(app);
		this.results = results;
		this.onSelect = onSelect;
	}

	onOpen() {
		const { contentEl } = this;

		contentEl.createEl('h2', {
			text: 'Select a TV show',
		});

		if (this.results.length === 0) {
			contentEl.createEl('p', {
				text: 'No TV shows found.',
			});

			const doneButton = contentEl.createEl('button', {
				text: 'Okay',
			});

			doneButton.style.marginTop = '10px';

			doneButton.addEventListener('click', () => {
				this.close();
			});

			return;
		}

		for (const show of this.results) {
			const year = show.first_air_date
				? show.first_air_date.substring(0, 4)
				: 'Unknown year';

			const item = contentEl.createEl('div');

			item.style.padding = '10px';
			item.style.cursor = 'pointer';
			item.style.borderBottom =
				'1px solid var(--background-modifier-border)';

			item.createEl('div', {
				text: show.name,
			});

			item.createEl('small', {
				text: `${year}  •  TMDB ID: ${show.id}`,
			});

			if (show.overview) {
				item.createEl('p', {
					text: getPlotPreview(show.overview),
				});
			}

			item.addEventListener('click', () => {
				this.onSelect(show);
				this.close();
			});
		}
	}

	onClose() {
		this.contentEl.empty();
	}
}

//this is for the settings tab.
class MovieSearcherSettingTab extends PluginSettingTab {
	plugin: MovieSearcherPlugin;

	constructor(app: App, plugin: MovieSearcherPlugin) {
		super(app, plugin);
		this.plugin = plugin;
	}

	display(): void {
		const { containerEl } = this;

		containerEl.empty();

		containerEl.createEl('h2', {
			text: 'Searcher Settings',
		});

		new Setting(containerEl)
			.setName('TMDB API Read Access Token')
			.setDesc('Enter your TMDB API read access token.')
			.addText((text) =>
				text
					.setPlaceholder('Enter API read access token')
					.setValue(this.plugin.settings.tmdbReadAccessToken)
					.onChange(async (value) => {
						this.plugin.settings.tmdbReadAccessToken = value;
						await this.plugin.saveSettings();
					}),
			);
    
    new Setting(containerEl)
      .setName('TMDB API Key')
      .setDesc('Enter your TMDB API key.')
      .addText((text) =>
        text
          .setPlaceholder('Enter TMDB API key')
          .setValue(this.plugin.settings.tmdbApiKey)
          .onChange(async (value) => {
            this.plugin.settings.tmdbApiKey = value;
            await this.plugin.saveSettings();
          }),
      );

		new Setting(containerEl)
			.setName('OMDB API Key')
			.setDesc('Enter your OMDB API key.')
			.addText((text) =>
				text
					.setPlaceholder('Enter OMDB API key')
					.setValue(this.plugin.settings.omdbApiKey)
					.onChange(async (value) => {
						this.plugin.settings.omdbApiKey = value;
						await this.plugin.saveSettings();
					}),
			);
    new Setting(containerEl)
    .setName('Cast members')
    .setDesc('Number of cast members to add to movie notes.')
    .addDropdown((dropdown) =>
		  dropdown
        .addOption('10', '10')
        .addOption('20', '20')
        .setValue(String(this.plugin.settings.castCount))
        .onChange(async (value) => {
          this.plugin.settings.castCount = Number(value);
				  await this.plugin.saveSettings();
			}),
	);
	}
}

//for list of certifications for the movie in the frontmatter.
function getCertification(
	releaseDates: any[],
): string {
	const usCertifications =
		getCountryCertifications(releaseDates, 'US');

	// 1. Highest available US rating
	if (usCertifications.length > 0) {
		return getHighestUSCertification(usCertifications);
	}

	// 2. No US rating → find best US equivalent
	const allCertifications =
		getAllCertifications(releaseDates);

	return getBestUSRatingEquivalent(allCertifications);
}

function getCountryCertifications(
	releaseDates: any[],
	countryCode: string,
): string[] {
	const region = releaseDates.find(
		(item: any) =>
			item.iso_3166_1 === countryCode,
	);

	if (!region?.release_dates) {
		return [];
	}

	return region.release_dates
		.map(
			(release: any) =>
				release.certification?.trim(),
		)
		.filter(
			(certification: string) =>
				certification.length > 0,
		);
}

function getAllCertifications(
	releaseDates: any[],
): {
	country: string;
	certification: string;
}[] {
	const certifications: {
		country: string;
		certification: string;
	}[] = [];

	for (const region of releaseDates) {
		for (const release of region.release_dates ?? []) {
			const certification =
				release.certification?.trim();

			if (!certification) {
				continue;
			}

			certifications.push({
				country: region.iso_3166_1,
				certification,
			});
		}
	}

	return certifications;
}

//equivalent ratings for different countries to US ratings.
function getBestUSRatingEquivalent(
	certifications: {
		country: string;
		certification: string;
	}[],
): string {
	const ratingLevels: Record<string, number> = {
		G: 1,
		PG: 2,
		'PG-13': 3,
		R: 4,
		'NC-17': 5,
	};

	let bestRating = '';
	let bestLevel = 0;

	for (const item of certifications) {
		const certification = item.certification
			.trim()
			.toUpperCase();

		let rating = '';
		let level = 0;

		// Common ratings already close to the US system
		if (certification === 'G') {
			rating = 'G';
			level = 1;
		} else if (certification === 'PG') {
			rating = 'PG';
			level = 2;
		} else if (
			certification === 'PG-13' ||
			certification === 'PG13'
		) {
			rating = 'PG-13';
			level = 3;
		} else if (
			certification === 'R' ||
			certification === '18' ||
			certification === '18+' ||
			certification === 'A' ||
			certification === 'VM18' ||
			certification === 'R18'
		) {
			rating = 'R';
			level = 4;
		} else if (
			certification === 'NC-17' ||
			certification === 'NC17'
		) {
			rating = 'NC-17';
			level = 5;
		}

		// General fallback for common age-number systems
		else if (
			['16', '16+', '15', '15+', '14', '14+'].includes(
				certification,
			)
		) {
			rating = 'R';
			level = 4;
		} else if (
			['13', '13+', '12', '12+', '12A'].includes(
				certification,
			)
		) {
			rating = 'PG-13';
			level = 3;
		} else if (
			['7', '7+', 'PG'].includes(
				certification,
			)
		) {
			rating = 'PG';
			level = 2;
		} else if (
			['U', '0', 'ALL', 'E'].includes(
				certification,
			)
		) {
			rating = 'G';
			level = 1;
		}

		if (level > bestLevel) {
			bestRating = rating;
			bestLevel = level;
		}
	}

	// If nothing could be interpreted, use the first
	// available certification rather than leaving it empty.
	if (!bestRating) {
	const firstCertification = certifications[0];

	if (firstCertification) {
		return firstCertification.certification;
	}

	return 'NR';
}

return bestRating;
}

function getHighestUSCertification(
	certifications: string[],
): string {
	const order: Record<string, number> = {
		G: 1,
		PG: 2,
		'PG-13': 3,
		R: 4,
		'NC-17': 5,
	};

	let best = '';
	let bestScore = -1;

	for (const certification of certifications) {
		const score =
			order[certification.toUpperCase()] ?? 0;

		if (score > bestScore) {
			best = certification;
			bestScore = score;
		}
	}

	return best || certifications[0] || '';
}

//this is the main plugin class.
// //I'm using TMDB's V4 API, which requires a Bearer token for authorization.
// It is a API Read Access Token from TMDB account settings.
export default class MovieSearcherPlugin extends Plugin {
	settings: MovieSearcherSettings = DEFAULT_SETTINGS;

	async onload() {
		await this.loadSettings();

		this.addSettingTab(
			new MovieSearcherSettingTab(this.app, this),
		);

		this.addCommand({
			id: 'movie-searcher',
			name: 'Add a Movie',
			callback: () => {
				new MovieSearchModal(
	        this.app,
	        async (query, mode) => {
            if (mode === 'title') {
              await this.searchTMDB(query);
            } else {
              await this.searchById(query);
            }
	        },
        ).open();
			},
		});

    this.addCommand({
      id: 'tv-show-searcher',
      name: 'Add a TV Show',
      callback: () => {
        new TVShowSearchModal(
          this.app,
          async (query, mode) => {
            if (mode === 'title') {
              await this.searchTVShows(query);
            } else {
              await this.searchTVById(query);
            }
          },
        ).open();
      },
    });

	}

	async loadSettings() {
		this.settings = Object.assign(
			{},
			DEFAULT_SETTINGS,
			await this.loadData(),
		);
	}

	async saveSettings() {
		await this.saveData(this.settings);
	}

	async searchTMDB(movieTitle: string) {
    //console.log('Movie Search: searchTMDB started', movieTitle);
	  const token = this.settings.tmdbReadAccessToken;

	  if (!token) {
		  new Notice(
			'TMDB API read access token is not configured.',
		  );
		return;
	}
    //console.log('Movie Search: token exists', token);
	let query = movieTitle.trim();
let year = '';

const yearMatch = query.match(
	/^(.+?)\s+(19\d{2}|20\d{2})$/,
);

if (yearMatch) {
	const titlePart = yearMatch[1];
	const yearPart = yearMatch[2];

	if (titlePart && yearPart) {
		query = titlePart;
		year = yearPart;
	}
}

	const params = new URLSearchParams();

params.set('query', query);

if (year) {
	params.set('year', year);
}

const url =
	'https://api.themoviedb.org/3/search/movie?' +
	params.toString();

try {
	const response = await requestUrl({
		url,
		method: 'GET',
		headers: {
			Authorization: `Bearer ${token}`,
			accept: 'application/json',
		},
	});

	const data = response.json;

	new MovieResultsModal(
		this.app,
		data.results ?? [],
		(movie) => {
			this.getmovie(movie.id);
		},
	).open();

} catch (error) {
	console.error(
		'TMDB movie search failed:',
		error,
	);

	new Notice(
		'TMDB movie search failed. Check console.',
	);
}
}

async searchById(query: string) {
	const value = query.trim();

	// IMDb ID
	if (/^tt\d+$/i.test(value)) {
		await this.findByIMDbId(value);
		return;
	}

	// TMDB numeric ID
	if (/^\d+$/.test(value)) {
		await this.getmovie(Number(value));
		return;
	}

	new Notice(
		'Enter a valid TMDB ID or IMDb ID.',
	);
}
	async getmovie(movieId: number) {
	const token = this.settings.tmdbReadAccessToken;

	if (!token) {
		new Notice('TMDB API read access token is not configured.');
		return;
	}

	const url =
		`https://api.themoviedb.org/3/movie/${movieId}` +
		'?append_to_response=credits,external_ids,release_dates';

	try {
		const response = await requestUrl({
			url,
			method: 'GET',
			headers: {
				Authorization: `Bearer ${token}`,
				accept: 'application/json',
			},
		});

		const movie = response.json;

		const imdbId =
			movie.external_ids?.imdb_id ?? '';

		const imdbRating =
			await this.getIMDbRating(imdbId);

		await this.createMovieNote(
			movie,
			imdbRating,
		);

	} catch (error) {
		console.error(
			'TMDB movie details request failed:',
			error,
		);

		new Notice('Could not load movie details.');
	}
}

  async findExistingMovie(
    tmdbId: number,
    imdbId: string,
  ): Promise<TFile | null> {
    const files = this.app.vault.getMarkdownFiles();

    for (const file of files) {
      if (!file.path.startsWith('Media/Movies/')) {
        continue;
      }

      const cache = this.app.metadataCache.getFileCache(file);

      if (!cache?.frontmatter) {
        continue;
      }

      const frontmatter = cache.frontmatter;

      if (
        String(frontmatter.tmdb_id) === String(tmdbId)
      ) {
        return file;
      }

      if (
        imdbId &&
        String(frontmatter.imdb_id) === imdbId
      ) {
        return file;
      }
    }

    return null;
  }
//this function gets the movie details by its TMDB ID.
  async getMovieByTmdbId(movieId: number) {
	const token = this.settings.tmdbReadAccessToken;

	if (!token) {
		new Notice('TMDB API read access token is not configured.');
		return;
	}

	try {
		const response = await requestUrl({
			url:
				`https://api.themoviedb.org/3/movie/${movieId}` +
				'?append_to_response=credits,external_ids,release_dates',
			method: 'GET',
			headers: {
				Authorization: `Bearer ${token}`,
				accept: 'application/json',
			},
		});

		const movie = response.json;

		const imdbId = movie.external_ids?.imdb_id ?? '';
		const imdbRating = await this.getIMDbRating(imdbId);

		await this.createMovieNote(movie, imdbRating);

	} catch (error) {
		console.error('TMDB ID lookup failed:', error);
		new Notice('Could not load the movie from TMDB ID.');
	}
}
//this function finds the movie by its IMDb ID.
async findByIMDbId(imdbId: string) {
	const token = this.settings.tmdbReadAccessToken;

	if (!token) {
		new Notice('TMDB API read access token is not configured.');
		return;
	}

	try {
		const response = await requestUrl({
			url:
				`https://api.themoviedb.org/3/find/${encodeURIComponent(imdbId)}` +
				'?external_source=imdb_id',
			method: 'GET',
			headers: {
				Authorization: `Bearer ${token}`,
				accept: 'application/json',
			},
		});

		const data = response.json;

		if (!data.movie_results?.length) {
			new Notice('No movie found for that IMDb ID.');
			return;
		}

		const movie = data.movie_results[0];

		await this.getmovie(movie.id);

	} catch (error) {
		console.error('IMDb ID lookup failed:', error);
		new Notice('Could not find that IMDb ID on TMDB.');
	}
}

//this function updates the existing movie note with the new details with frontmatter.
  async updateMovieNote(
	file: TFile,
	movie: any,
	imdbRating: number | null,
  ) {
  //console.log('Updating movie file:', file.path);
	const releaseDate = movie.release_date ?? '';
	const year = releaseDate
		? releaseDate.substring(0, 4)
		: '';

	const originalTitle = movie.original_title ?? '';

	const runtime = formatRuntime(movie.runtime);

	const genres =
		movie.genres?.map((genre: any) => genre.name) ?? [];

	const languages =
		movie.spoken_languages?.map(
			(language: any) => language.english_name,
		) ?? [];

	const countries =
		movie.production_countries?.map(
			(country: any) => country.name,
		) ?? [];

	const studios =
		movie.production_companies?.map(
			(company: any) => company.name,
		) ?? [];

	const director =
		movie.credits?.crew
			?.filter(
				(person: any) => person.job === 'Director',
			)
			.map((person: any) => person.name) ?? [];

	const writers =
		movie.credits?.crew
			?.filter(
				(person: any) =>
					person.job === 'Writer' ||
					person.job === 'Screenplay' ||
					person.job === 'Story',
			)
			.map((person: any) => person.name) ?? [];

	const producer =
		movie.credits?.crew
			?.filter(
				(person: any) => person.job === 'Producer',
			)
			.map((person: any) => person.name) ?? [];

	const cast =
		movie.credits?.cast
			?.slice(0, this.settings.castCount)
			.map((person: any) => person.name) ?? [];

	const certification = getCertification(
	movie.release_dates?.results ?? [],
);

	const poster = movie.poster_path
	? `https://image.tmdb.org/t/p/w780${movie.poster_path}`
	: '';

	await this.app.fileManager.processFrontMatter(
		file,
		(frontmatter) => {
			frontmatter.title = movie.title ?? '';
			frontmatter.original_title = originalTitle;

			frontmatter.tmdb_id = movie.id ?? '';
			frontmatter.imdb_id =
				movie.external_ids?.imdb_id ?? '';

			frontmatter.released = releaseDate;
			frontmatter.year = year;
			frontmatter.runtime = runtime;
			frontmatter.imdb = imdbRating ?? '';

			frontmatter.genres = genres;
			frontmatter.languages = languages;
			frontmatter.countries = countries;

			frontmatter.rated = certification;

			frontmatter.director = director;
			frontmatter.writer = writers;
			frontmatter.producer = producer;
			frontmatter.cast = cast;
			frontmatter.studio = studios;

			frontmatter.poster = poster;
			frontmatter.plot = movie.overview ?? '';
		},
	);

	new Notice(`Updated: ${file.basename}`);
}
  //for imdb rating
  async getIMDbRating(imdbId: string): Promise<number | null> {
	const apiKey = this.settings.omdbApiKey;

	if (!apiKey) {
		new Notice('OMDb API key is not configured.');
		return null;
	}

	if (!imdbId) {
		console.warn('No IMDb ID available for this movie.');
		return null;
	}

	const url =
		`https://www.omdbapi.com/?apikey=${encodeURIComponent(apiKey)}` +
		`&i=${encodeURIComponent(imdbId)}` +
		`&plot=short`;

	try {
		const response = await requestUrl({
			url,
			method: 'GET',
		});

		const data = response.json;

		if (data.Response !== 'True') {
			console.warn('OMDb error:', data.Error);
			new Notice(
				`OMDb: ${data.Error ?? 'Movie not found'}`,
			);
			return null;
		}

		const imdbRating =
			Number.parseFloat(data.imdbRating);

		if (Number.isNaN(imdbRating)) {
			return null;
		}

		return imdbRating;
	} catch (error) {
		console.error(
			'IMDb rating request failed:',
			error,
		);

		new Notice(
			'Could not retrieve IMDb rating.',
		);

		return null;
	}
}

  //this function creates a markdown file with the movie details in the vault.
async createMovieNote(
	movie: any,
	imdbRating: number | null,
) {
	const title = movie.title ?? '';
	const tmdbId = movie.id ?? '';
	const imdbId = movie.external_ids?.imdb_id ?? '';

	const existingFile = await this.findExistingMovie(
		tmdbId,
		imdbId,
	);

	if (existingFile) {
		await this.updateMovieNote(
			existingFile,
			movie,
			imdbRating,
		);
		return;
	}

	const releaseDate = movie.release_date ?? '';
const year = releaseDate ? releaseDate.substring(0, 4) : '';

const originalTitle = movie.original_title ?? '';

const runtime = formatRuntime(movie.runtime);

const genres =
	movie.genres?.map((genre: any) => genre.name) ?? [];

const languages =
	movie.spoken_languages?.map(
		(language: any) => language.english_name,
	) ?? [];

const countries =
	movie.production_countries?.map(
		(country: any) => country.name,
	) ?? [];

const studios =
	movie.production_companies?.map(
		(company: any) => company.name,
	) ?? [];

const director =
	movie.credits?.crew
		?.filter((person: any) => person.job === 'Director')
		.map((person: any) => person.name) ?? [];

const writers =
	movie.credits?.crew
		?.filter(
			(person: any) =>
				person.job === 'Writer' ||
				person.job === 'Screenplay' ||
				person.job === 'Story',
		)
		.map((person: any) => person.name) ?? [];

const producer =
  movie.credits?.crew
    ?.filter((person: any) => person.job === 'Producer')
    .map((person: any) => person.name) ?? [];

const cast =
	movie.credits?.cast
		?.slice(0, this.settings.castCount)
		.map((person: any) => person.name) ?? [];

const certification = getCertification(
	movie.release_dates?.results ?? [],
);

const poster = movie.poster_path
	? `https://image.tmdb.org/t/p/w500${movie.poster_path}`
	: '';

const markdown = `---
type: movie
title: ${JSON.stringify(title)}
original_title: ${JSON.stringify(originalTitle)}
tmdb_id: ${tmdbId}
imdb_id: ${JSON.stringify(imdbId)}

released: ${releaseDate}
year: ${year}
runtime: ${runtime}
imdb: ${imdbRating ?? ''}

genres:
${genres.map((genre: string) => `  - ${JSON.stringify(genre)}`).join('\n')}

languages:
${languages.map((language: string) => `  - ${JSON.stringify(language)}`).join('\n')}

countries:
${countries.map((country: string) => `  - ${JSON.stringify(country)}`).join('\n')}

rated: ${JSON.stringify(certification)}

director:
${director.map((person: string) => `  - ${JSON.stringify(person)}`).join('\n')}

writer:
${writers.map((person: string) => `  - ${JSON.stringify(person)}`).join('\n')}

producer:
${producer.map((person: string) => `  - ${JSON.stringify(person)}`).join('\n')}

cast:
${cast.map((person: string) => `  - ${JSON.stringify(person)}`).join('\n')}

studio:
${studios.map((studio: string) => `  - ${JSON.stringify(studio)}`).join('\n')}

poster: ${JSON.stringify(poster)}
plot: ${JSON.stringify(movie.overview ?? '')}

watched: false
date_watched:
rating:
tags:
---
`;

const folder = 'Media/Movies';

if (!this.app.vault.getAbstractFileByPath(folder)) {
	await this.app.vault.createFolder(folder);
}

const fileName = year
	? `${title} (${year})`
	: title;

const safeFileName = sanitizeFileName(fileName);

const filePath = `${folder}/${safeFileName}.md`;

// 2. Also check the exact filename
const existingPath = this.app.vault.getAbstractFileByPath(filePath);

if (existingPath instanceof TFile) {
	new Notice(`File already exists: ${filePath}`);
	return;
}

// 3. Create the note safely
try {
	await this.app.vault.create(filePath, markdown);
	new Notice(`Added: ${filePath}`);
  //console.log(`Added movie note: ${filePath}`);
} catch (error) {
	console.error('Failed to create movie note:', error);
	new Notice('Could not create movie note.');
}
    
	}

//For TV show search
async searchTVShows(queryText: string) {
	//console.log('TV Show Search: searchTVShows started',queryText);

	const token = this.settings.tmdbReadAccessToken;

	if (!token) {
		new Notice(
			'TMDB API read access token is not configured.',
		);
		return;
	}

	let query = queryText.trim();
	let year = '';

	// Detect a trailing year.
	const yearMatch = query.match(
		/^(.+?)\s+(19\d{2}|20\d{2})$/,
	);

	if (yearMatch) {
		const titlePart = yearMatch[1];
		const yearPart = yearMatch[2];

		if (titlePart && yearPart) {
			query = titlePart;
			year = yearPart;
		}
	}

	const params = new URLSearchParams();

	params.set('query', query);

	if (year) {
		params.set('first_air_date_year', year);
	}

	const url =
		'https://api.themoviedb.org/3/search/tv?' +
		params.toString();

	try {
		const response = await requestUrl({
			url,
			method: 'GET',
			headers: {
				Authorization: `Bearer ${token}`,
				accept: 'application/json',
			},
		});

		const data = response.json;

		new TVShowResultsModal(
			this.app,
			data.results ?? [],
			(show) => {
				this.getTVShow(show.id);
			},
		).open();

	} catch (error) {
		console.error(
			'TMDB TV show search failed:',
			error,
		);

		new Notice(
			'TMDB TV show search failed. Check console.',
		);
	}
}

async searchTVById(query: string) {
	const value = query.trim();

	// IMDb ID
	if (/^tt\d+$/i.test(value)) {
		await this.findTVByIMDbId(value);
		return;
	}

	// TMDB numeric ID
	if (/^\d+$/.test(value)) {
		await this.getTVShow(Number(value));
		return;
	}

	new Notice(
		'Enter a valid TMDB ID or IMDb ID.',
	);
}

async findTVByIMDbId(imdbId: string) {
	const token = this.settings.tmdbReadAccessToken;

	if (!token) {
		new Notice(
			'TMDB API read access token is not configured.',
		);
		return;
	}

	try {
		const response = await requestUrl({
			url:
				`https://api.themoviedb.org/3/find/${encodeURIComponent(imdbId)}` +
				'?external_source=imdb_id',
			method: 'GET',
			headers: {
				Authorization: `Bearer ${token}`,
				accept: 'application/json',
			},
		});

		const data = response.json;

		if (!data.tv_results?.length) {
			new Notice(
				'No TV show found for that IMDb ID.',
			);
			return;
		}

		const show = data.tv_results[0];

		await this.getTVShow(show.id);

	} catch (error) {
		console.error(
			'TV IMDb ID lookup failed:',
			error,
		);

		new Notice(
			'Could not find that IMDb ID on TMDB.',
		);
	}
}

async getTVShow(tvId: number) {
	const token = this.settings.tmdbReadAccessToken;

	if (!token) {
		new Notice(
			'TMDB API read access token is not configured.',
		);
		return;
	}

	const url =
		`https://api.themoviedb.org/3/tv/${tvId}` +
		'?append_to_response=credits,external_ids,content_ratings';

	try {
		const response = await requestUrl({
			url,
			method: 'GET',
			headers: {
				Authorization: `Bearer ${token}`,
				accept: 'application/json',
			},
		});

		const show = response.json;

		//console.log('TV show details:', show);

		const imdbId =
			show.external_ids?.imdb_id ?? '';

		const imdbRating =
			await this.getIMDbRating(imdbId);

		await this.createTVShowNote(
			show,
			imdbRating,
		);

	} catch (error) {
		console.error(
			'TMDB TV show details request failed:',
			error,
		);

		new Notice(
			'Could not load TV show details.',
		);
	}
}

async createTVShowNote(
	show: any,
	imdbRating: number | null,
) {
	const folder = 'Media/TV Shows';

	if (!this.app.vault.getAbstractFileByPath(folder)) {
		await this.app.vault.createFolder(folder);
	}

	const firstAirDate = show.first_air_date ?? '';
	const firstYear = firstAirDate
		? firstAirDate.substring(0, 4)
		: 'Unknown';

	const lastAirDate = show.last_air_date ?? '';

	let years = '';

	if (firstYear !== 'Unknown') {
		if (
			show.status === 'Ended' ||
			show.status === 'Canceled'
		) {
			const lastYear = lastAirDate
				? lastAirDate.substring(0, 4)
				: firstYear;

			years =
				lastYear === firstYear
					? firstYear
					: `${firstYear}-${lastYear}`;
		} else {
			years = `${firstYear}-present`;
		}
	}


	const imdbId =
		show.external_ids?.imdb_id ?? '';

	const genres = (show.genres ?? [])
		.map((genre: any) => genre.name)

	const languages = (show.spoken_languages ?? [])
		.map((language: any) => language.english_name)

	const countries = (show.production_countries ?? [])
		.map((country: any) => country.name)

	const creators = (show.created_by ?? [])
		.map((person: any) => person.name)

	const studios = (show.production_companies ?? [])
		.map((company: any) => company.name)

	const cast = (show.credits?.cast ?? [])
		.slice(0, 20)
		.map((person: any) => person.name)

	const rated = this.getTVCertification(
		show.content_ratings?.results ?? [],
	);

	// One entry for every season
	const episodes = (show.seasons ?? [])
		.filter((season: any) => season.season_number > 0)
		.map((season: any) => {
			const seasonNumber = String(
				season.season_number,
			).padStart(2, '0');

			const episodeCount = season.episode_count ?? 0;

			return `S${seasonNumber}.E${episodeCount}`;
		});

	const poster = show.poster_path
		? `https://image.tmdb.org/t/p/w780${show.poster_path}`
		: '';

	const title = show.name ?? '';
	const originalTitle =
		show.original_name ?? title;

	const filename =
		`${sanitizeFileName(title)} (${firstYear}).md`;

	const path = `${folder}/${filename}`;

	const content = `---
type: tv
title: ${JSON.stringify(title)}
original_title: ${JSON.stringify(originalTitle)}
tmdb_id: ${show.id}
imdb_id: ${JSON.stringify(imdbId)}

released: ${JSON.stringify(firstAirDate)}
years: ${JSON.stringify(years)}
imdb: ${imdbRating ?? ''}

genres: ${JSON.stringify(genres)}

languages: ${JSON.stringify(languages)}

countries: ${JSON.stringify(countries)}

rated: ${JSON.stringify(rated)}

creator: ${JSON.stringify(creators)}

cast: ${JSON.stringify(cast)}

studio: ${JSON.stringify(studios)}

poster: ${JSON.stringify(poster)}
plot: ${JSON.stringify(show.overview ?? '')}

episodes:
${episodes.map((episode: string) => `  - ${episode}`).join('\n')}

started:
rating:
binged:
tags:
---
`;

	try {
		const existingFile =
			this.app.vault.getAbstractFileByPath(path);

		if (existingFile instanceof TFile) {
			new Notice(
				`TV show already exists: ${title}`,
			);

			return;
		}

		await this.app.vault.create(path, content);

		new Notice(
			`Added TV show: ${title}`,
		);

	} catch (error) {
		console.error(
			'Failed to create TV show note:',
			error,
		);

		new Notice(
			'Could not create TV show note.',
		);
	}
}

async updateTVShowNote(
	file: TFile,
	show: any,
	imdbRating: number | null,
) {
	const imdbId =
		show.external_ids?.imdb_id ?? '';
  const existingFile =
    await this.findExistingTVShow(
      show.id,
      imdbId,
    );

  if (existingFile) {
    await this.updateTVShowNote(
      existingFile,
      show,
      imdbRating,
    );
    return;
  }
	const firstAirDate =
		show.first_air_date ?? '';

	const firstYear = firstAirDate
		? firstAirDate.substring(0, 4)
		: '';

	const lastAirDate =
		show.last_air_date ?? '';

	let years = '';

	if (firstYear) {
		if (
			show.status === 'Ended' ||
			show.status === 'Canceled'
		) {
			const lastYear = lastAirDate
				? lastAirDate.substring(0, 4)
				: firstYear;

			years =
				lastYear === firstYear
					? firstYear
					: `${firstYear}-${lastYear}`;
		} else {
			years = `${firstYear}-present`;
		}
	}

	const genres = (show.genres ?? [])
		.map((genre: any) => genre.name)
		.join(', ');

	const languages = (show.spoken_languages ?? [])
		.map((language: any) => language.english_name)
		.join(', ');

	const countries = (show.production_countries ?? [])
		.map((country: any) => country.name)
		.join(', ');

	const creators = (show.created_by ?? [])
		.map((person: any) => person.name)
		.join(', ');

	const studios = (show.production_companies ?? [])
		.map((company: any) => company.name)
		.join(', ');

	// TV always uses 20 cast members
	const cast = (show.credits?.cast ?? [])
		.slice(0, 20)
		.map((person: any) => person.name)
		.join(', ');

	const rated = this.getTVCertification(
		show.content_ratings?.results ?? [],
	);

	const episodes = (show.seasons ?? [])
		.filter((season: any) => season.season_number > 0)
		.map((season: any) => {
			const seasonNumber = String(
				season.season_number,
			).padStart(2, '0');

			const episodeCount =
				season.episode_count ?? 0;

			return `S${seasonNumber}.E${episodeCount}`;
		});

	const poster = show.poster_path
		? `https://image.tmdb.org/t/p/w780${show.poster_path}`
		: '';

	const title = show.name ?? '';

	const originalTitle =
		show.original_name ?? title;

	try {
		await this.app.fileManager.processFrontMatter(
			file,
			(frontmatter) => {

				// External metadata
				frontmatter.type = 'tv';
				frontmatter.title = title;
				frontmatter.original_title =
					originalTitle;

				frontmatter.tmdb_id = show.id;
				frontmatter.imdb_id = imdbId;

				frontmatter.released =
					firstAirDate;

				frontmatter.years =
					years;

				frontmatter.imdb =
					imdbRating ?? '';

				frontmatter.genres =
					genres;

				frontmatter.languages =
					languages;

				frontmatter.countries =
					countries;

				frontmatter.rated =
					rated;

				frontmatter.creator =
					creators;

				frontmatter.cast =
					cast;

				frontmatter.studio =
					studios;

				frontmatter.poster =
					poster;

				frontmatter.plot =
					show.overview ?? '';

				frontmatter.episodes =
					episodes;

				// Do NOT touch:
				// started
				// rating
				// binged
				// tags
			},
		);

		new Notice(
			`Updated TV show: ${title}`,
		);

	} catch (error) {
		console.error(
			'Failed to update TV show note:',
			error,
		);

		new Notice(
			'Could not update TV show note.',
		);
	}
}

getTVCertification(
	contentRatings: any[],
): string {
	const usRatings = contentRatings
		.filter(
			(item: any) =>
				item.iso_3166_1 === 'US' &&
				item.rating,
		)
		.map((item: any) => item.rating);

	if (usRatings.length > 0) {
		return this.getHighestTVUSCertification(usRatings);
	}

	const allRatings = contentRatings
		.filter((item: any) => item.rating)
		.map((item: any) => item.rating);

	if (allRatings.length === 0) {
		return 'NR';
	}

	return this.getBestTVUSRatingEquivalent(allRatings);
}

getHighestTVUSCertification(
	ratings: string[],
): string {
	const order = [
		'TV-Y',
		'TV-Y7',
		'TV-G',
		'TV-PG',
		'TV-14',
		'TV-MA',
	];

	let highest = 'TV-Y';

	for (const rating of ratings) {
		const normalized = rating
			.trim()
			.toUpperCase();

		const index = order.indexOf(normalized);
		const highestIndex = order.indexOf(highest);

		if (index > highestIndex) {
			highest = normalized;
		}
	}

	return highest;
}

getBestTVUSRatingEquivalent(
	ratings: string[],
): string {
	for (const rating of ratings) {
		const normalized = rating
			.trim()
			.toUpperCase()
			.replace(/\s+/g, '');

		if (
			normalized === 'TV-MA' ||
			normalized === '18' ||
			normalized === '18+' ||
			normalized === 'R18'
		) {
			return 'TV-MA';
		}

		if (
			normalized === 'TV-14' ||
			normalized === '14' ||
			normalized === '14+' ||
			normalized === '16' ||
			normalized === '16+' ||
			normalized === '15' ||
			normalized === '15+'
		) {
			return 'TV-14';
		}

		if (
			normalized === 'TV-PG' ||
			normalized === 'PG' ||
			normalized === '12' ||
			normalized === '12+' ||
			normalized === '12A'
		) {
			return 'TV-PG';
		}

		if (
			normalized === 'TV-Y7' ||
			normalized === '7' ||
			normalized === '7+'
		) {
			return 'TV-Y7';
		}

		if (
			normalized === 'TV-G' ||
			normalized === 'G' ||
			normalized === 'U' ||
			normalized === '0' ||
			normalized === 'ALL'
		) {
			return 'TV-G';
		}
	}

	// If an unknown rating exists, preserve it
	const firstRating = ratings[0];

	if (firstRating) {
		return firstRating;
	}

	return 'NR';
}

async findExistingTVShow(
	tmdbId: number,
	imdbId: string,
): Promise<TFile | null> {
	const files =
		this.app.vault.getMarkdownFiles();

	for (const file of files) {
		if (!file.path.startsWith('Media/TV Shows/')) {
			continue;
		}

		const cache =
			this.app.metadataCache.getFileCache(file);

		if (!cache?.frontmatter) {
			continue;
		}

		const frontmatter =
			cache.frontmatter;

		if (
			String(frontmatter.tmdb_id) ===
			String(tmdbId)
		) {
			return file;
		}

		if (
			imdbId &&
			String(frontmatter.imdb_id) ===
			imdbId
		) {
			return file;
		}
	}

	return null;
}

}
// to clean up movie title name.
function sanitizeFileName(name: string): string {
	return name.replace(/[\\/:*?"<>|]/g, '');
}

// to format the runtime of the movie in hours and minutes.
function formatRuntime(minutes: number | null): string {
	if (!minutes || minutes <= 0) {
		return '';
	}

	const hours = Math.floor(minutes / 60);
	const remainingMinutes = minutes % 60;

	if (hours > 0 && remainingMinutes > 0) {
		return `${hours}h ${remainingMinutes}m`;
	}

	if (hours > 0) {
		return `${hours}h`;
	}

	return `${remainingMinutes}m`;
}

function getPlotPreview(plot: string, maxLength = 180): string {
	if (plot.length <= maxLength) {
		return plot;
	}

	return plot.substring(0, maxLength).trimEnd() + '…';
}
