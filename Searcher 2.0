//Fully working Searcher for movie and tv shows for both platforms.
//Please ensure compatible dns is used cause network provider dns may cause problems and slow down. use gns.google(8.8.8.8 & 8.8.4.4)

import {
	App,
	Modal,
	Notice,
	Plugin,
	PluginSettingTab,
	Setting,
  TFile,
  requestUrl
} from 'obsidian';

interface MovieSearcherSettings {
	tmdbReadAccessToken: string;
  tmdbApiKey: string;
  omdbApiKey: string;
	castCount: number;
}

const DEFAULT_SETTINGS: MovieSearcherSettings = {
	tmdbReadAccessToken: '',
  tmdbApiKey: '',
  omdbApiKey: '',
	castCount: 10,
};
//this is for first input tab.
type SearchMode = 'title' | 'id';

class MovieSearchModal extends Modal {
	onSubmit: (
		query: string,
		mode: SearchMode,
	) => Promise<void>;

	searchMode: SearchMode = 'title';

	constructor(
		app: App,
		onSubmit: (
			query: string,
			mode: SearchMode,
		) => Promise<void>,
	) {
		super(app);
		this.onSubmit = onSubmit;
	}

	onOpen() {
		const { contentEl } = this;

		contentEl.createEl('h2', {
			text: 'Add movie',
		});

		const input = contentEl.createEl('input', {
			type: 'text',
			placeholder: 'Movie title + year...',
		});

		input.style.width = '100%';

		const modeContainer = contentEl.createEl('div');

		modeContainer.style.display = 'flex';
		modeContainer.style.gap = '6px';
		modeContainer.style.marginTop = '10px';

		const titleButton = modeContainer.createEl('button', {
			text: 'Title',
		});

		const idButton = modeContainer.createEl('button', {
			text: 'ID',
		});

		const updateMode = () => {
			if (this.searchMode === 'title') {
				titleButton.addClass('mod-cta');
				idButton.removeClass('mod-cta');

				input.placeholder =
					'Movie title + year...';
			} else {
				idButton.addClass('mod-cta');
				titleButton.removeClass('mod-cta');

				input.placeholder =
					'Enter TMDB ID or IMDb ID...';
			}
		};

		titleButton.addEventListener('click', () => {
			this.searchMode = 'title';
			updateMode();
			input.focus();
		});

		idButton.addEventListener('click', () => {
			this.searchMode = 'id';
			updateMode();
			input.focus();
		});

		updateMode();

		const button = contentEl.createEl('button', {
			text: 'Search',
		});

		button.style.marginTop = '10px';

		const submitSearch = async () => {
			const query = input.value.trim();

			if (!query) {
				new Notice(
					'Please enter a movie title or ID.',
				);
				return;
			}

			try {
				await this.onSubmit(
					query,
					this.searchMode,
				);

				this.close();
			} catch (error) {
				console.error(
					'Movie search failed:',
					error,
				);

				new Notice(
					'Movie search failed.',
				);
			}
		};

		button.addEventListener(
			'click',
			submitSearch,
		);

		input.addEventListener('keydown', (event) => {
			if (event.key === 'Enter') {
				event.preventDefault();
				event.stopPropagation();

				submitSearch();
			}
		});

		input.focus();
	}

	onClose() {
		this.contentEl.empty();
	}
}

