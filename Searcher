interface MovieSearcherSettings {
	tmdbReadAccessToken: string;
  omdbApiKey: string;
	castCount: number;
}

const DEFAULT_SETTINGS: MovieSearcherSettings = {
	tmdbReadAccessToken: '',
  omdbApiKey: '',
	castCount: 10,
};
//this is for first input tab.
class MovieSearchModal extends Modal {
	onSubmit: (movieTitle: string) => void;

	constructor(app: App, onSubmit: (movieTitle: string) => void) {
		super(app);
		this.onSubmit = onSubmit;
	}

	onOpen() {
	const { contentEl } = this;

	contentEl.createEl('h2', {
		text: 'Search for a movie',
	});

	const input = contentEl.createEl('input', {
		type: 'text',
		placeholder: 'Enter movie title...',
	});

	input.style.width = '100%';

	const button = contentEl.createEl('button', {
		text: 'Search',
	});

	button.style.marginTop = '10px';

	const submitSearch = () => {
		const movieTitle = input.value.trim();

		if (!movieTitle) {
			new Notice('Please enter a movie title.');
			return;
		}

		this.onSubmit(movieTitle);
		this.close();
	};

	button.addEventListener('click', submitSearch);

	input.addEventListener('keydown', (event) => {
		if (event.key === 'Enter') {
			event.preventDefault();
			event.stopPropagation();

			submitSearch();
		}
	});

	input.focus();
}

	onClose() {
		this.contentEl.empty();
	}
}
//this is for second modal that shows the results of the search.
class MovieResultsModal extends Modal {
	results: any[];
	onSelect: (movie: any) => void;

	constructor(
		app: App,
		results: any[],
		onSelect: (movie: any) => void,
	) {
		super(app);
		this.results = results;
		this.onSelect = onSelect;
	}

	onOpen() {
	const { contentEl } = this;

	contentEl.createEl('h2', { text: 'Select a movie' });

	if (this.results.length === 0) {
		contentEl.createEl('p', {
			text: 'No movies found.',
		});

		const doneButton = contentEl.createEl('button', {
			text: 'Okay',
		});

		doneButton.style.marginTop = '10px';

		doneButton.addEventListener('click', () => {
			this.close();
		});

		return;
	}

	for (const movie of this.results) {
		const year = movie.release_date
			? movie.release_date.substring(0, 4)
			: 'Unknown year';

		const item = contentEl.createEl('div');

		item.style.padding = '10px';
		item.style.cursor = 'pointer';
		item.style.borderBottom =
			'1px solid var(--background-modifier-border)';

		item.createEl('div', {
			text: movie.title,
		});

		item.createEl('small', {
			text: `${year}  •  TMDB ID: ${movie.id}`,
		});

		if (movie.overview) {
			item.createEl('p', {
				text: getPlotPreview(movie.overview),
			});
		}

		item.addEventListener('click', () => {
			this.onSelect(movie);
			this.close();
		});
	}
}

	onClose() {
		this.contentEl.empty();
	}
}
//this is for the settings tab.
class MovieSearcherSettingTab extends PluginSettingTab {
	plugin: MovieSearcherPlugin;

	constructor(app: App, plugin: MovieSearcherPlugin) {
		super(app, plugin);
		this.plugin = plugin;
	}

	display(): void {
		const { containerEl } = this;

		containerEl.empty();

		containerEl.createEl('h2', {
			text: 'Searcher Settings',
		});

		new Setting(containerEl)
			.setName('TMDB API Read Access Token')
			.setDesc('Enter your TMDB API read access token.')
			.addText((text) =>
				text
					.setPlaceholder('Enter API read access token')
					.setValue(this.plugin.settings.tmdbReadAccessToken)
					.onChange(async (value) => {
						this.plugin.settings.tmdbReadAccessToken = value;
						await this.plugin.saveSettings();
					}),
			);

		new Setting(containerEl)
			.setName('OMDB API Key')
			.setDesc('Enter your OMDB API key.')
			.addText((text) =>
				text
					.setPlaceholder('Enter OMDB API key')
					.setValue(this.plugin.settings.omdbApiKey)
					.onChange(async (value) => {
						this.plugin.settings.omdbApiKey = value;
						await this.plugin.saveSettings();
					}),
			);
    new Setting(containerEl)
    .setName('Cast members')
    .setDesc('Number of cast members to add to movie notes.')
    .addDropdown((dropdown) =>
		  dropdown
        .addOption('10', '10')
        .addOption('20', '20')
        .setValue(String(this.plugin.settings.castCount))
        .onChange(async (value) => {
          this.plugin.settings.castCount = Number(value);
				  await this.plugin.saveSettings();
			}),
	);
	}
}

//for universal rating system for age rating.
function getGlobalRating(releaseDates: any[]): string {
	// First preference: US certification
	const us = releaseDates.find(
		(region: any) => region.iso_3166_1 === 'US',
	);

	const usCertification = us?.release_dates
		?.find((release: any) => release.certification?.trim())
		?.certification
		?.trim();

	if (usCertification) {
		return usCertification;
	}

	// Fallback: CBFC / India certification
	const india = releaseDates.find(
		(region: any) => region.iso_3166_1 === 'IN',
	);

	const cbfcCertification = india?.release_dates
		?.find((release: any) => release.certification?.trim())
		?.certification
		?.trim();

	if (!cbfcCertification) {
		return '';
	}

	const normalized = cbfcCertification
		.toUpperCase()
		.replace(/\s+/g, '')
		.replace(/\//g, '');

	// CBFC → your normalized global/MPAA-style rating
	if (normalized === 'U') {
		return 'G';
	}

	if (
		normalized === 'UA' ||
		normalized.startsWith('UA')
	) {
		return 'PG';
	}

	if (normalized === 'A') {
		return 'PG-13';
	}

	if (normalized === 'S') {
		return 'R';
	}

	// Unknown certification: return it unchanged
	return cbfcCertification;
}

//this is the main plugin class.
// //I'm using TMDB's V4 API, which requires a Bearer token for authorization.
// It is a API Read Access Token from TMDB account settings.
export default class MovieSearcherPlugin extends Plugin {
	settings: MovieSearcherSettings = DEFAULT_SETTINGS;

	async onload() {
		await this.loadSettings();

		this.addSettingTab(
			new MovieSearcherSettingTab(this.app, this),
		);

		this.addCommand({
			id: 'movie-searcher',
			name: 'Add a Movie',
			callback: () => {
				new MovieSearchModal(this.app, async (movieTitle) => {
					await this.searchTMDB(movieTitle);
				}).open();
			},
		});
	}

	async loadSettings() {
		this.settings = Object.assign(
			{},
			DEFAULT_SETTINGS,
			await this.loadData(),
		);
	}

	async saveSettings() {
		await this.saveData(this.settings);
	}

	async searchTMDB(movieTitle: string) {
		const token = this.settings.tmdbReadAccessToken;

		if (!token) {
			new Notice('TMDB API read access token is not configured.');
			return;
		}

		const url =
			'https://api.themoviedb.org/3/search/movie?query=' +
			encodeURIComponent(movieTitle);

		const response = await fetch(url, {
			headers: {
				Authorization: `Bearer ${token}`,
				accept: 'application/json',
			},
		});

		if (!response.ok) {
			new Notice(`TMDB request failed: ${response.status}`);
			return;
		}

		const data = await response.json();

		new MovieResultsModal(
			this.app,
			data.results,
			(movie) => {
				console.log('Selected movie:', movie);

				this.getmovie(movie.id);
			},
		).open();
	}

	async getmovie(movieId: number) {
		const token = this.settings.tmdbReadAccessToken;

		if (!token) {
			new Notice('TMDB API read access token is not configured.');
			return;
		}

		const url =
			`https://api.themoviedb.org/3/movie/${movieId}` +
			'?append_to_response=credits,external_ids,release_dates';

		const response = await fetch(url, {
			headers: {
				Authorization: `Bearer ${token}`,
				accept: 'application/json',
			},
		});

		if (!response.ok) {
			new Notice(`TMDB details request failed: ${response.status}`);
			return;
		}

		const movie = await response.json();
		console.log('Full movie details:', movie);
		const imdbId = movie.external_ids?.imdb_id ?? '';
		const imdbRating = await this.getIMDbRating(imdbId);
		await this.createMovieNote(movie, imdbRating);
		//new Notice(`Loaded: ${movie.title}`);
    console.log(`Loaded movie details: ${movie.title}`);
	}

  async findExistingMovie(
    tmdbId: number,
    imdbId: string,
  ): Promise<TFile | null> {
    const files = this.app.vault.getMarkdownFiles();

    for (const file of files) {
      if (!file.path.startsWith('Movies/')) {
        continue;
      }

      const cache = this.app.metadataCache.getFileCache(file);

      if (!cache?.frontmatter) {
        continue;
      }

      const frontmatter = cache.frontmatter;

      if (
        String(frontmatter.tmdb_id) === String(tmdbId)
      ) {
        return file;
      }

      if (
        imdbId &&
        String(frontmatter.imdb_id) === imdbId
      ) {
        return file;
      }
    }

    return null;
  }
//this function updates the existing movie note with the new details with frontmatter.
  async updateMovieNote(
	file: TFile,
	movie: any,
	imdbRating: number | null,
  ) {
  //console.log('Updating movie file:', file.path);
	const releaseDate = movie.release_date ?? '';
	const year = releaseDate
		? releaseDate.substring(0, 4)
		: '';

	const originalTitle = movie.original_title ?? '';

	const runtime = formatRuntime(movie.runtime);

	const genres =
		movie.genres?.map((genre: any) => genre.name) ?? [];

	const languages =
		movie.spoken_languages?.map(
			(language: any) => language.english_name,
		) ?? [];

	const countries =
		movie.production_countries?.map(
			(country: any) => country.name,
		) ?? [];

	const studios =
		movie.production_companies?.map(
			(company: any) => company.name,
		) ?? [];

	const director =
		movie.credits?.crew
			?.filter(
				(person: any) => person.job === 'Director',
			)
			.map((person: any) => person.name) ?? [];

	const writers =
		movie.credits?.crew
			?.filter(
				(person: any) =>
					person.job === 'Writer' ||
					person.job === 'Screenplay' ||
					person.job === 'Story',
			)
			.map((person: any) => person.name) ?? [];

	const producer =
		movie.credits?.crew
			?.filter(
				(person: any) => person.job === 'Producer',
			)
			.map((person: any) => person.name) ?? [];

	const cast =
		movie.credits?.cast
			?.slice(0, this.settings.castCount)
			.map((person: any) => person.name) ?? [];

	const globalRating = getGlobalRating(
		movie.release_dates?.results ?? [],
	);

	const poster = movie.poster_path
		? `https://image.tmdb.org/t/p/w500${movie.poster_path}`
		: '';

	await this.app.fileManager.processFrontMatter(
		file,
		(frontmatter) => {
			frontmatter.title = movie.title ?? '';
			frontmatter.original_title = originalTitle;

			frontmatter.tmdb_id = movie.id ?? '';
			frontmatter.imdb_id =
				movie.external_ids?.imdb_id ?? '';

			frontmatter.release_date = releaseDate;
			frontmatter.year = year;
			frontmatter.runtime = runtime;
			frontmatter.imdb = imdbRating ?? '';

			frontmatter.genres = genres;
			frontmatter.languages = languages;
			frontmatter.countries = countries;

			frontmatter.certification = globalRating;

			frontmatter.director = director;
			frontmatter.writer = writers;
			frontmatter.producer = producer;
			frontmatter.cast = cast;
			frontmatter.studio = studios;

			frontmatter.poster = poster;
			frontmatter.plot = movie.overview ?? '';
		},
	);

	new Notice(`Updated: ${file.basename}`);
}
  //for imdb rating
  async getIMDbRating(imdbId: string): Promise<number | null> {
	const apiKey = this.settings.omdbApiKey;

	if (!apiKey) {
		new Notice('OMDb API key is not configured.');
		return null;
	}

	if (!imdbId) {
		console.warn('No IMDb ID available for this movie.');
		return null;
	}

	const url =
		`https://www.omdbapi.com/?apikey=${encodeURIComponent(apiKey)}` +
		`&i=${encodeURIComponent(imdbId)}` +
		`&plot=short`;

	try {
		const response = await fetch(url);

		if (!response.ok) {
			new Notice(`OMDb request failed: ${response.status}`);
			return null;
		}

		const data = await response.json();

		console.log('OMDb response:', data);

		if (data.Response !== 'True') {
			console.warn('OMDb error:', data.Error);
			new Notice(`OMDb: ${data.Error ?? 'Movie not found'}`);
			return null;
		}

		const imdbRating = Number.parseFloat(data.imdbRating);

		if (Number.isNaN(imdbRating)) {
			return null;
		}

		return imdbRating;
	} catch (error) {
		console.error('IMDb rating request failed:', error);
		new Notice('Could not retrieve IMDb rating.');
		return null;
	}
  
}

  //this function creates a markdown file with the movie details in the vault.
async createMovieNote(
	movie: any,
	imdbRating: number | null,
) {
	const title = movie.title ?? '';
	const tmdbId = movie.id ?? '';
	const imdbId = movie.external_ids?.imdb_id ?? '';

	const existingFile = await this.findExistingMovie(
		tmdbId,
		imdbId,
	);

	if (existingFile) {
		await this.updateMovieNote(
			existingFile,
			movie,
			imdbRating,
		);
		return;
	}

	const releaseDate = movie.release_date ?? '';
const year = releaseDate ? releaseDate.substring(0, 4) : '';

const originalTitle = movie.original_title ?? '';

const runtime = formatRuntime(movie.runtime);

//const rating = imdbRating ?? '';

const genres =
	movie.genres?.map((genre: any) => genre.name) ?? [];

const languages =
	movie.spoken_languages?.map(
		(language: any) => language.english_name,
	) ?? [];

const countries =
	movie.production_countries?.map(
		(country: any) => country.name,
	) ?? [];

const studios =
	movie.production_companies?.map(
		(company: any) => company.name,
	) ?? [];

const director =
	movie.credits?.crew
		?.filter((person: any) => person.job === 'Director')
		.map((person: any) => person.name) ?? [];

const writers =
	movie.credits?.crew
		?.filter(
			(person: any) =>
				person.job === 'Writer' ||
				person.job === 'Screenplay' ||
				person.job === 'Story',
		)
		.map((person: any) => person.name) ?? [];

const producer =
  movie.credits?.crew
    ?.filter((person: any) => person.job === 'Producer')
    .map((person: any) => person.name) ?? [];

const cast =
	movie.credits?.cast
		?.slice(0, this.settings.castCount)
		.map((person: any) => person.name) ?? [];

const globalRating = getGlobalRating(
	movie.release_dates?.results ?? [],
);

const poster = movie.poster_path
	? `https://image.tmdb.org/t/p/w500${movie.poster_path}`
	: '';

const markdown = `---
type: movie
title: ${JSON.stringify(title)}
original_title: ${JSON.stringify(originalTitle)}
tmdb_id: ${tmdbId}
imdb_id: ${JSON.stringify(imdbId)}

release_date: ${releaseDate}
year: ${year}
runtime: ${runtime}
imdb: ${imdbRating ?? ''}

genres:
${genres.map((genre: string) => `  - ${JSON.stringify(genre)}`).join('\n')}

languages:
${languages.map((language: string) => `  - ${JSON.stringify(language)}`).join('\n')}

countries:
${countries.map((country: string) => `  - ${JSON.stringify(country)}`).join('\n')}

certification: ${JSON.stringify(globalRating)}

director:
${director.map((person: string) => `  - ${JSON.stringify(person)}`).join('\n')}

writer:
${writers.map((person: string) => `  - ${JSON.stringify(person)}`).join('\n')}

producer:
${producer.map((person: string) => `  - ${JSON.stringify(person)}`).join('\n')}

cast:
${cast.map((person: string) => `  - ${JSON.stringify(person)}`).join('\n')}

studio:
${studios.map((studio: string) => `  - ${JSON.stringify(studio)}`).join('\n')}

poster: ${JSON.stringify(poster)}
plot: ${JSON.stringify(movie.overview ?? '')}

watched: false
date_watched:
rating:
---
`;

const folder = 'Movies';

if (!this.app.vault.getAbstractFileByPath(folder)) {
	await this.app.vault.createFolder(folder);
}

const fileName = year
	? `${title} (${year})`
	: title;

const safeFileName = sanitizeFileName(fileName);

const filePath = `${folder}/${safeFileName}.md`;

// 2. Also check the exact filename
const existingPath = this.app.vault.getAbstractFileByPath(filePath);

if (existingPath instanceof TFile) {
	new Notice(`File already exists: ${filePath}`);
	return;
}

// 3. Create the note safely
try {
	await this.app.vault.create(filePath, markdown);
	new Notice(`Added: ${filePath}`);
  console.log(`Added movie note: ${filePath}`);
} catch (error) {
	console.error('Failed to create movie note:', error);
	new Notice('Could not create movie note.');
}
    
	}
}
// to clean up movie title name.
function sanitizeFileName(name: string): string {
	return name.replace(/[\\/:*?"<>|]/g, '');
}

// to format the runtime of the movie in hours and minutes.
function formatRuntime(minutes: number | null): string {
	if (!minutes || minutes <= 0) {
		return '';
	}

	const hours = Math.floor(minutes / 60);
	const remainingMinutes = minutes % 60;

	if (hours > 0 && remainingMinutes > 0) {
		return `${hours}h ${remainingMinutes}m`;
	}

	if (hours > 0) {
		return `${hours}h`;
	}

	return `${remainingMinutes}m`;
}

function getPlotPreview(plot: string, maxLength = 180): string {
	if (plot.length <= maxLength) {
		return plot;
	}

	return plot.substring(0, maxLength).trimEnd() + '…';
}

